import socket
from time import sleep
import binascii

# Adresse IP et port de destination
server_address = ('1.1.1.1', 4626)

# Adresse IP de l'interface wlan0 de votre Raspberry Pi
source_address = '1.1.1.2'

# Message hexadécimal
dim = 10

hex_message_dim = f'fbc1b056{str(format(int(dim * 0x1F / 100), "02X"))}0100a8003a0c00b23a0c00' # 3

prgm = "802"
hex_message_prog = f'fbc5b{str(prgm)}b23a0c00'
print(hex_message_prog)

# vitesse
#speed = "f601" #lent
#speed = "c101" # moyen

dim = 10
speed = 50
format_dim = str(format(int(dim * 0x1F / 100), "02X")).lower()
format_speed = str(format(int(speed * 0x1F / 100), "02X")).lower()

speed = "f6"

hex_message_speed = f'fbc1{speed}{format_speed}{format_dim}0100a8003a0c00b23a0c00'
print(len(hex_message_speed))

message = binascii.unhexlify(hex_message_speed)

# Convertir la chaîne hexadécimale en une séquence d'octets

# Créer un socket UDP
sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)

try:
    # Lier le socket à l'interface wlan0
    sock.bind((source_address, 0))

    # Envoyer le message au serveur
    sent = sock.sendto(message, server_address)
    print(f"Sent {sent} bytes to {server_address} from {source_address}")

finally:
    # Fermer le socket
    sock.close()


